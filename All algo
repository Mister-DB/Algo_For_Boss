import random
from dataclasses import dataclass, field
from functools import wraps
from typing import Iterator
# Миха весь успех через запуск

# ---------- Битовые флаги стен ----------
N, E, S, W = 1, 2, 4, 8  # North, East, South, West

OPPOSITE = {N: S, E: W, S: N, W: E}
DX = {N: 0, E: 1, S: 0, W: -1}
DY = {N: -1, E: 0, S: 1, W: 0}


# ---------- Декоратор с прогрессом ----------
def traced(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        wrapper.calls += 1
        return func(*args, **kwargs)
    wrapper.calls = 0
    return wrapper


@dataclass
class Cell:
    walls: int = N | E | S | W
    visited: bool = False
    set_id: int = field(default_factory=lambda: -1)


class Maze:
    def __init__(self, width: int, height: int, seed: int | None = None) -> None:
        self.w = width
        self.h = height
        self.rng = random.Random(seed)
        self.grid: list[list[Cell]] = [
            [Cell() for _ in range(width)] for _ in range(height)
        ]
        self._next_set = 0

    # ---------- Утилиты ----------
    def _new_set(self) -> int:
        self._next_set += 1
        return self._next_set

    def _carve(self, x: int, y: int, direction: int) -> None:
        nx, ny = x + DX[direction], y + DY[direction]
        self.grid[y][x].walls &= ~direction
        self.grid[ny][nx].walls &= ~OPPOSITE[direction]

    # ---------- Алгоритм Эллера ----------
    def generate(self) -> "Maze":
        for y in range(self.h):
            for x in range(self.w):
                if self.grid[y][x].set_id == -1:
                    self.grid[y][x].set_id = self._new_set()

            # Горизонтальные соединения
            for x in range(self.w - 1):
                a, b = self.grid[y][x], self.grid[y][x + 1]
                if a.set_id != b.set_id and (
                    y == self.h - 1 or self.rng.random() < 0.5
                ):
                    self._carve(x, y, E)
                    old, new = b.set_id, a.set_id
                    self._merge_sets(old, new)

            # Вертикальные соединения
            if y == self.h - 1:
                for x in range(self.w - 1):
                    a, b = self.grid[y][x], self.grid[y][x + 1]
                    if a.set_id != b.set_id:
                        self._carve(x, y, E)
                        self._merge_sets(b.set_id, a.set_id)
                break

            groups: dict[int, list[int]] = {}
            for x in range(self.w):
                groups.setdefault(self.grid[y][x].set_id, []).append(x)

            for set_id, xs in groups.items():
                down = self.rng.sample(xs, k=self.rng.randint(1, len(xs)))
                for x in down:
                    self._carve(x, y, S)
                    self.grid[y + 1][x].set_id = set_id

            for x in range(self.w):
                if self.grid[y + 1][x].set_id == -1:
                    self.grid[y + 1][x].set_id = self._new_set()

        return self

    def _merge_sets(self, old: int, new: int) -> None:
        for row in self.grid:
            for cell in row:
                if cell.set_id == old:
                    cell.set_id = new

    # ---------- Обход в глубину ----------
    @traced
    def solve(self, sx: int = 0, sy: int = 0) -> Iterator[tuple[int, int]]:
        stack = [(sx, sy)]
        seen = {(sx, sy)}
        path: list[tuple[int, int]] = []

        while stack:
            x, y = stack[-1]
            path.append((x, y))

            if (x, y) == (self.w - 1, self.h - 1):
                yield from path
                return

            neighbours = [
                (x + DX[d], y + DY[d], d)
                for d in (N, E, S, W)
                if not self.grid[y][x].walls & d
                and 0 <= x + DX[d] < self.w
                and 0 <= y + DY[d] < self.h
                and (x + DX[d], y + DY[d]) not in seen
            ]

            if not neighbours:
                stack.pop()
                path.pop()
                continue

            nx, ny, _ = self.rng.choice(neighbours)
            seen.add((nx, ny))
            stack.append((nx, ny))

    # ---------- Отрисовка ----------
    def render(self, path: set[tuple[int, int]] | None = None) -> str:
        path = path or set()
        lines = ["┌" + "───┬" * (self.w - 1) + "───┐"]

        for y in range(self.h):
            row = "│"
            for x in range(self.w):
                if (x, y) in path:
                    row += " \033[92m•\033[0m "
                else:
                    row += "   "
                row += "│" if self.grid[y][x].walls & E else " "
            lines.append(row)

            if y < self.h - 1:
                sep = "├"
                for x in range(self.w):
                    sep += "───" if self.grid[y][x].walls & S else "   "
                    sep += "┼" if x < self.w - 1 else "┤"
                lines.append(sep)

        lines.append("└" + "───┴" * (self.w - 1) + "───┘")
        return "\n".join(lines)


if __name__ == "__main__":
    maze = Maze(width=15, height=8, seed=42).generate()
    solution = set(maze.solve())
    print(maze.render(solution))
    print(f"\nВызовов solve(): {Maze.solve.calls}")
    print(f"Длина пути: {len(solution)}")

